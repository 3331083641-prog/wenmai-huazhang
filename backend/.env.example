GENERATION_PROVIDER=dashscope_qwen_image
ALLOW_MOCK_FALLBACK=false
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0
QWEN_VL_ENABLED=true
QWEN_VL_BASE_URL=http://127.0.0.1:11434
QWEN_VL_MODEL=qwen3-vl:4b-instruct-q4_K_M
QWEN_VL_TIMEOUT=180
QWEN_VL_CONTEXT_TOKENS=8192
QWEN_VL_TEMPERATURE=0.65

# 生成结果自动沉淀为展厅案例
# 每次真实生成成功后，把成图/参考图/文化卡/metadata 写入 docs/examples/<styleId>-<时间戳>/
AUTO_SAVE_CASES=true
# 是否连 mock / fast_demo 的演示图也保存（仅本机验证链路时打开）
AUTO_SAVE_DEMO=false
# 运行期案例数量上限，超出后删除最旧的一件（内置案例永不清理）
AUTO_SAVE_MAX_CASES=200

# 自动互动：仅本地 Qwen3-VL 写内容；本地深度模型辅助 2.5D
AUTO_BUILD_INTERACTIVE=true
# 首次运行 scripts/setup_interactive_models.py 安装并校验本地权重
# model 缺权重时明确失败；geometry 仅用于显式选择的近似显示模式
WENMAI_DEPTH_MODE=model

# DeepSeek 官方视觉复审配置；真实密钥只填本机 backend/.env。
# 说明见 docs/configuration/DEEPSEEK_OFFICIAL.md；百炼可选模式另见 BAILIAN_DEEPSEEK.md。
# 与生图的 DASHSCOPE_* 分开，保留已有生图及本地 Qwen3-VL 配置。
DEEPSEEK_PROVIDER=official
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 官方 deepseek-flash 当前对应 DeepSeek-V4.1-Flash-1017，支持图像输入。
DEEPSEEK_MODEL=deepseek-flash
# 首次配置默认不发起云端复审；明确启用后每件最多3轮，不重复生图。
DEEPSEEK_REVIEW_ENABLED=false
DEEPSEEK_MAX_REVIEW_CALLS=3
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TIMEOUT_SECONDS=180
# 本机所有自动复审任务合计的每日请求上限，失败请求也计数。
DEEPSEEK_DAILY_REVIEW_LIMIT=24
