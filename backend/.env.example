GENERATION_PROVIDER=dashscope_qwen_image
ALLOW_MOCK_FALLBACK=false
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_IMAGE_MODEL=qwen-image-3.0
QWEN_VL_ENABLED=true
QWEN_VL_BASE_URL=http://127.0.0.1:11434
QWEN_VL_MODEL=qwen3-vl:4b-instruct-q4_K_M
QWEN_VL_TIMEOUT=180
QWEN_VL_CONTEXT_TOKENS=8192
QWEN_VL_TEMPERATURE=0.65

# 生成结果自动沉淀为展厅案例
# 每次真实生成成功后，把成图/参考图/文化卡/metadata 写入 docs/examples/<styleId>-<时间戳>/
AUTO_SAVE_CASES=true
# 是否连 mock / fast_demo 的演示图也保存（仅本机验证链路时打开）
AUTO_SAVE_DEMO=false
# 运行期案例数量上限，超出后删除最旧的一件（内置案例永不清理）
AUTO_SAVE_MAX_CASES=200
