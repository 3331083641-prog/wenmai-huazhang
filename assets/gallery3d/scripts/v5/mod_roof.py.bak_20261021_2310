"""V5 roof system: hip roof with real tile courses, wadang, ridges and eave.

The V4 failure this module exists to fix:
  * rafters were modelled ON TOP of the tile surface, so the roof read as a
    pile of sticks lying on a tent;
  * tile courses were thin swept tubes at 0.31 m spacing, which at render
    scale collapsed into faint lines;
  * wadang (round tile ends) were flat discs floating outside the eave.

Correct stack, from the inside out:
    rafters -> eave fascia + drip board -> tile bed (solid slab)
            -> flat tile troughs (banwa) -> half-round caps (tongwa)
            -> wadang at every cap end -> ridges on the hip / main lines.

Naming: every object here starts with ROOF_ or TILE_ so the web layer can hide
the whole roof when the camera steps inside (see GalleryModel.tsx).
"""

from __future__ import annotations

import math

import bpy
from mathutils import Vector

import gal5 as G


# ------------------------------------------------------------------ helpers
def _surface_normal(x, y, w, d, eave_z, ridge_z, lift, k, eps=0.06):
    """Numerical normal of the hip surface (points up / outward)."""
    p0 = Vector((x, y, G.roof_point(x, y, w, d, eave_z, ridge_z, lift=lift, k=k)))
    px = Vector((x + eps, y, G.roof_point(x + eps, y, w, d, eave_z, ridge_z, lift=lift, k=k)))
    py = Vector((x, y + eps, G.roof_point(x, y + eps, w, d, eave_z, ridge_z, lift=lift, k=k)))
    n = (px - p0).cross(py - p0)
    if n.length < 1e-7:
        return Vector((0, 0, 1))
    n.normalize()
    if n.z < 0:
        n = -n
    return n


def _walk_slope(x0, y0, dx, dy, w, d, eave_z, ridge_z, lift, k, step=0.14,
                t_limit=1.0):
    """March from the eave inward until the slope's own region ends.

    t_limit is the key to a clean hip roof: a course belongs to one plane only,
    and that plane's t stops where the other pair of edges becomes nearer.
    Without it the side courses march straight across the front slope and the
    whole roof turns into a diagonal lattice (the bug in the first pass).
    """
    pts = []
    x, y = x0, y0
    prev_t = -1.0
    guard = 0
    while guard < 400:
        guard += 1
        half_w, half_d = w * 0.5, d * 0.5
        dist = min(half_d - abs(y), half_w - abs(x))
        t = max(0.0, min(1.0, dist / half_d))
        if t < prev_t - 1e-5:
            break
        prev_t = t
        z = G.roof_point(x, y, w, d, eave_z, ridge_z, lift=lift, k=k)
        pts.append((x, y, z))
        if t >= min(0.999, t_limit):
            break
        x += dx * step
        y += dy * step
        if abs(x) > half_w + 1e-6 or abs(y) > half_d + 1e-6:
            break
    return pts


def _rib(verts, faces, pts, radius, w, d, eave_z, ridge_z, lift, k, arc=6,
         base_off=0.012):
    """Append one half-round tile cap swept along `pts`."""
    rings = []
    for idx, p in enumerate(pts):
        n = _surface_normal(p[0], p[1], w, d, eave_z, ridge_z, lift, k)
        p_prev = pts[max(0, idx - 1)]
        p_next = pts[min(len(pts) - 1, idx + 1)]
        tan = Vector((p_next[0] - p_prev[0], p_next[1] - p_prev[1],
                      p_next[2] - p_prev[2]))
        if tan.length < 1e-6:
            tan = Vector((0, 1, 0))
        tan.normalize()
        side = tan.cross(n)
        if side.length < 1e-6:
            continue
        side.normalize()
        up = n
        centre = Vector(p) + n * base_off
        ring = []
        for a in range(arc + 1):
            ang = math.pi * a / arc
            off = side * (radius * math.cos(ang)) + up * (radius * math.sin(ang))
            ring.append(centre + off)
        rings.append(ring)
    if len(rings) < 2:
        return
    start = len(verts)
    for ring in rings:
        verts.extend([tuple(v) for v in ring])
    span = arc + 1
    for idx in range(len(rings) - 1):
        for a in range(arc):
            v0 = start + idx * span + a
            faces.append((v0, v0 + 1, v0 + span + 1, v0 + span))
    # close both ends so the caps are solid from every angle
    faces.append(tuple(start + a for a in range(arc + 1)))
    last = start + (len(rings) - 1) * span
    faces.append(tuple(last + a for a in range(arc, -1, -1)))


def tile_field(name, w, d, eave_z, ridge_z, col, material, spacing=0.30,
               radius=0.078, lift=0.26, k=0.58, skip=None):
    """Four hip slopes of real half-round tile caps.

    skip(x, y) -> True drops a row, used to keep the eave clear of props.
    """
    verts, faces = [], []
    half_w, half_d = w * 0.5, d * 0.5

    # front (-Y) and back (+Y) slopes: rows run along X, march along Y
    n_x = int(round(w / spacing))
    for i in range(n_x + 1):
        x = -half_w + w * i / n_x
        if abs(x) > half_w - spacing * 0.5:
            continue
        t_lim = min(1.0, (half_w - abs(x)) / half_d)
        for sign in (-1, 1):
            pts = _walk_slope(x, sign * half_d, 0.0, -sign, w, d,
                              eave_z, ridge_z, lift, k, t_limit=t_lim)
            if len(pts) < 3:
                continue
            if skip and skip(pts[0][0], pts[0][1] + G.BCY):
                continue
            _rib(verts, faces, pts, radius, w, d, eave_z, ridge_z, lift, k)

    # left (-X) and right (+X) slopes: rows run along Y, march along X
    n_y = int(round(d / spacing))
    for j in range(n_y + 1):
        y = -half_d + d * j / n_y
        if abs(y) > half_d - spacing * 0.5:
            continue
        t_lim = min(1.0, (half_d - abs(y)) / half_d)
        for sign in (-1, 1):
            pts = _walk_slope(sign * half_w, y, -sign, 0.0, w, d,
                              eave_z, ridge_z, lift, k, t_limit=t_lim)
            if len(pts) < 3:
                continue
            if skip and skip(pts[0][0], pts[0][1] + G.BCY):
                continue
            _rib(verts, faces, pts, radius, w, d, eave_z, ridge_z, lift, k)

    ob = G.add_mesh(name, verts, faces, col, material)
    return ob


def banwa_bed(name, w, d, eave_z, ridge_z, col, material, spacing=0.30,
              depth=0.030, lift=0.26, k=0.58):
    """Flat tile troughs (banwa) under the caps: a second, offset relief layer.

    Without this the roof between the caps is one smooth grey surface and the
    courses do not read once the model is scaled down in the browser.
    """
    verts, faces = [], []
    half_w, half_d = w * 0.5, d * 0.5
    ridge_half = (w - d) * 0.5

    def strip(x0, y0, dx, dy, length, t_limit):
        pts = _walk_slope(x0, y0, dx, dy, w, d, eave_z, ridge_z, lift, k,
                          t_limit=t_limit)
        if len(pts) < 2:
            return
        start = len(verts)
        for p in pts:
            n = _surface_normal(p[0], p[1], w, d, eave_z, ridge_z, lift, k)
            side = Vector((-dy, dx, 0.0))
            if side.length < 1e-6:
                side = Vector((1, 0, 0))
            side.normalize()
            a = Vector(p) + n * 0.004 + side * (length * 0.5)
            b = Vector(p) + n * 0.004 - side * (length * 0.5)
            verts.append(tuple(a))
            verts.append(tuple(b))
        for idx in range(len(pts) - 1):
            v0 = start + idx * 2
            faces.append((v0, v0 + 1, v0 + 3, v0 + 2))

    n_x = int(round(w / spacing))
    for i in range(n_x):
        x = -half_w + spacing * (i + 0.5)
        t_lim = min(1.0, (half_w - abs(x)) / half_d)
        for sign in (-1, 1):
            strip(x, sign * half_d, 0.0, -sign, spacing * 0.72, t_lim)
    n_y = int(round(d / spacing))
    for j in range(n_y):
        y = -half_d + spacing * (j + 0.5)
        t_lim = min(1.0, (half_d - abs(y)) / half_d)
        for sign in (-1, 1):
            strip(sign * half_w, y, -sign, 0.0, spacing * 0.72, t_lim)

    return G.add_mesh(name, verts, faces, col, material)


def wadang_row(name, w, d, eave_z, ridge_z, col, material, spacing=0.30,
               radius=0.088, lift=0.26, k=0.58):
    """Round tile ends aligned with every cap, plus a drip (danshui) between.

    The V4 version placed these discs at a fixed z outside the eave, which is
    why they looked like coins glued to the roof edge. Here each one is seated
    on the actual eave point of its own course.
    """
    verts, faces = [], []
    half_w, half_d = w * 0.5, d * 0.5

    def add_disc(p, outward, r, thick):
        n = outward.normalized()
        side = n.cross(Vector((0, 0, 1)))
        if side.length < 1e-6:
            side = Vector((1, 0, 0))
        side.normalize()
        up = side.cross(n).normalized()
        seg = 14
        start = len(verts)
        for s in (0.0, thick):
            for a in range(seg):
                ang = 2 * math.pi * a / seg
                verts.append(tuple(Vector(p) + n * s +
                                   side * (r * math.cos(ang)) +
                                   up * (r * math.sin(ang))))
        for a in range(seg):
            b = (a + 1) % seg
            faces.append((start + a, start + b, start + seg + b, start + seg + a))
        faces.append(tuple(start + a for a in range(seg - 1, -1, -1)))
        faces.append(tuple(start + seg + a for a in range(seg)))

    def add_drip(p, outward, r):
        n = outward.normalized()
        side = n.cross(Vector((0, 0, 1)))
        if side.length < 1e-6:
            side = Vector((1, 0, 0))
        side.normalize()
        up = side.cross(n).normalized()
        start = len(verts)
        for off in (0.0, 0.045):
            verts.append(tuple(Vector(p) + n * off + side * r * 0.62))
            verts.append(tuple(Vector(p) + n * off - side * r * 0.62))
            verts.append(tuple(Vector(p) + n * off + up * (-r * 1.35)))
        faces.append((start, start + 1, start + 2))
        faces.append((start + 3, start + 5, start + 4))
        faces.append((start, start + 3, start + 4, start + 1))
        faces.append((start + 1, start + 4, start + 5, start + 2))
        faces.append((start + 2, start + 5, start + 3, start))

    n_x = int(round(w / spacing))
    for i in range(n_x + 1):
        x = -half_w + w * i / n_x
        if abs(x) > half_w - spacing * 0.5:
            continue
        for sign in (-1, 1):
            y = sign * half_d
            z = G.roof_point(x, y, w, d, eave_z, ridge_z, lift=lift, k=k)
            n = _surface_normal(x, y, w, d, eave_z, ridge_z, lift, k)
            out = Vector((0, sign, 0)) * 0.6 + n * 0.55
            add_disc((x, y + G.BCY, z), out, radius, 0.055)
            if i < n_x:
                xm = x + spacing * 0.5
                if abs(xm) < half_w - 0.02:
                    zm = G.roof_point(xm, y, w, d, eave_z, ridge_z, lift=lift, k=k)
                    nm = _surface_normal(xm, y, w, d, eave_z, ridge_z, lift, k)
                    add_drip((xm, y + G.BCY, zm), Vector((0, sign, 0)) * 0.6 + nm * 0.55,
                             radius)

    n_y = int(round(d / spacing))
    for j in range(n_y + 1):
        y = -half_d + d * j / n_y
        if abs(y) > half_d - spacing * 0.5:
            continue
        for sign in (-1, 1):
            x = sign * half_w
            z = G.roof_point(x, y, w, d, eave_z, ridge_z, lift=lift, k=k)
            n = _surface_normal(x, y, w, d, eave_z, ridge_z, lift, k)
            out = Vector((sign, 0, 0)) * 0.6 + n * 0.55
            add_disc((x, y + G.BCY, z), out, radius, 0.055)
            if j < n_y:
                ym = y + spacing * 0.5
                if abs(ym) < half_d - 0.02:
                    zm = G.roof_point(x, ym, w, d, eave_z, ridge_z, lift=lift, k=k)
                    nm = _surface_normal(x, ym, w, d, eave_z, ridge_z, lift, k)
                    add_drip((x, ym + G.BCY, zm), Vector((sign, 0, 0)) * 0.6 + nm * 0.55,
                             radius)

    return G.add_mesh(name, verts, faces, col, material)


def swept_ridge(name, pts, col, material, width=0.30, height=0.22, layers=3,
                taper=0.16):
    """Stacked ridge (zhengji / chuji) following a 3D polyline."""
    obs = []
    for layer in range(layers):
        shrink = 1.0 - layer * taper
        verts, faces = [], []
        start = len(verts)
        for idx, p in enumerate(pts):
            p_prev = pts[max(0, idx - 1)]
            p_next = pts[min(len(pts) - 1, idx + 1)]
            tan = Vector(p_next) - Vector(p_prev)
            if tan.length < 1e-6:
                tan = Vector((1, 0, 0))
            tan.normalize()
            side = tan.cross(Vector((0, 0, 1)))
            if side.length < 1e-6:
                side = Vector((1, 0, 0))
            side.normalize()
            z0 = height * (0.18 + layer * 0.92)
            hw = width * shrink * 0.5
            base = Vector(p) + Vector((0, 0, z0))
            for corner in ((-hw, 0.0), (hw, 0.0), (hw, height * shrink),
                           (-hw, height * shrink)):
                verts.append(tuple(base + side * corner[0] +
                                   Vector((0, 0, corner[1]))))
        for idx in range(len(pts) - 1):
            a = start + idx * 4
            b = start + (idx + 1) * 4
            for k in range(4):
                k2 = (k + 1) % 4
                faces.append((a + k, a + k2, b + k2, b + k))
        faces.append((start, start + 1, start + 2, start + 3))
        end = start + (len(pts) - 1) * 4
        faces.append((end + 3, end + 2, end + 1, end))
        obs.append(G.add_mesh("%s_L%d" % (name, layer), verts, faces, col, material))
    return G.join_objs(name, obs)


def chiwen(name, loc, col, material, facing=1.0, scale=1.0):
    """Ridge-end ornament: a curled fin, extruded from a styled profile."""
    profile = [(0.00, 0.00), (0.16, 0.02), (0.34, 0.20), (0.46, 0.52),
               (0.40, 0.78), (0.24, 0.84), (0.14, 0.68), (0.20, 0.50),
               (0.30, 0.40), (0.22, 0.30), (0.05, 0.24)]
    thick = 0.10 * scale
    verts, faces = [], []
    for (u, v) in profile:
        verts.append((u * scale, -thick * 0.5, v * scale))
        verts.append((u * scale, thick * 0.5, v * scale))
    n = len(profile)
    for i in range(n):
        a = i * 2
        b = ((i + 1) % n) * 2
        faces.append((a, a + 1, b + 1, b))
    cap_a = [i * 2 for i in range(n)]
    cap_b = [i * 2 + 1 for i in range(n)]
    faces.append(tuple(cap_a))
    faces.append(tuple(reversed(cap_b)))
    ob = G.add_mesh(name, verts, faces, col, material, loc=loc)
    if facing < 0:
        ob.scale = (-1.0, 1.0, 1.0)
    return ob


def bracket_set(name, x, y, z, col, mat_wood, mat_gold, rot_z=0.0):
    """Three-tier bracket silhouette (dou / gong / ang) under the eave."""
    obs = []
    # Painted timber, not gold: at 0.19 m a gold block reads as a pale brick.
    # Only the small cap plate keeps the metal, so the tiering still shows.
    obs.append(G.add_box(name + "_Dou", (0.17, 0.17, 0.11), (x, y, z), col,
                         mat_wood, rot_z=rot_z))
    obs.append(G.add_box(name + "_Gong1", (0.50, 0.10, 0.075), (x, y, z + 0.10),
                         col, mat_wood, rot_z=rot_z))
    obs.append(G.add_box(name + "_Gong2", (0.10, 0.34, 0.07), (x, y, z + 0.185),
                         col, mat_wood, rot_z=rot_z))
    obs.append(G.add_box(name + "_Ang", (0.085, 0.24, 0.06), (x, y, z + 0.255),
                         col, mat_wood, rot_z=rot_z))
    obs.append(G.add_box(name + "_Tip", (0.20, 0.055, 0.028), (x, y, z + 0.135),
                         col, mat_gold, rot_z=rot_z))
    return obs



def eave_fascia(name, w, d, eave_z, col, mat, lift=0.26, k=0.58, seg=26,
                drop=0.055, thick=0.11, height=0.11, ridge_z=None):
    """Fascia board segmented along the eave so it follows the corner lift.

    A single straight box at a fixed z punches out through the roof surface at
    the four lifted corners and reads as two sticks flying past the eave.
    """
    ridges = G.RIDGE_Z if ridge_z is None else ridge_z
    obs = []
    half_w, half_d = w * 0.5, d * 0.5
    for sign in (-1, 1):
        y = G.BCY + sign * half_d
        for i in range(seg):
            x0 = -half_w + w * i / seg
            x1 = -half_w + w * (i + 1) / seg
            z = G.roof_point((x0 + x1) * 0.5, sign * half_d, w, d,
                             eave_z, ridges, lift=lift, k=k) - drop
            obs.append(G.add_box("%s_F%d_%d" % (name, sign, i),
                                 (x1 - x0 + 0.004, thick, height),
                                 ((x0 + x1) * 0.5, y, z), col, mat))
    for sign in (-1, 1):
        x = sign * half_w
        for i in range(seg):
            y0 = -half_d + d * i / seg
            y1 = -half_d + d * (i + 1) / seg
            z = G.roof_point(sign * half_w, (y0 + y1) * 0.5, w, d,
                             eave_z, ridges, lift=lift, k=k) - drop
            obs.append(G.add_box("%s_S%d_%d" % (name, sign, i),
                                 (thick, y1 - y0 + 0.004, height),
                                 (x, G.BCY + (y0 + y1) * 0.5, z), col, mat))
    return obs
def eave_assembly(name, w, d, eave_z, col, mat_wood, mat_gold, mat_tile_d,
                  spacing_raf=0.30, spacing_dou=0.62, lift=0.26, k=0.58,
                  simple=False, ridge_z=None):
    """Fascia + rafter ends + bracket sets, all BELOW the roof slab.

    This is the fix for the V4 bug: nothing here is allowed to rise above
    eave_z, otherwise the rafters show up on top of the tiles again.
    """
    obs = []
    half_w, half_d = w * 0.5, d * 0.5
    top = eave_z - 0.02
    if simple:
        # secondary ring eave: fascia only, no rafter tails hanging in air
        obs.extend(eave_fascia(name, w, d, eave_z, col, mat_wood, lift=lift, k=k, ridge_z=ridge_z))
        return obs

    obs.extend(eave_fascia(name, w, d, eave_z, col, mat_wood, lift=lift, k=k, ridge_z=ridge_z))
    for sign in (-1, 1):
        y_out = G.BCY + sign * half_d

        # rafter ends
        n = max(4, int(round(w / spacing_raf)))
        for i in range(n + 1):
            x = -half_w + 0.12 + i * (w - 0.24) / n
            obs.append(G.add_box("%s_RafF%d_%d" % (name, sign, i),
                                 (0.085, 0.40, 0.10),
                                 (x, y_out - sign * 0.14, top - 0.13), col, mat_wood))
        # bracket sets
        nd = max(3, int(round(w / spacing_dou)))
        for i in range(nd + 1):
            x = -half_w + 0.35 + i * (w - 0.70) / nd
            obs.extend(bracket_set("%s_DouF%d_%d" % (name, sign, i), x,
                                   y_out - sign * 0.30, top - 0.30, col,
                                   mat_wood, mat_gold))

    for sign in (-1, 1):
        x_out = sign * half_w

        n = max(4, int(round(d / spacing_raf)))
        for i in range(n + 1):
            y = G.BCY - half_d + 0.12 + i * (d - 0.24) / n
            obs.append(G.add_box("%s_RafS%d_%d" % (name, sign, i),
                                 (0.40, 0.085, 0.10),
                                 (x_out - sign * 0.14, y, top - 0.13), col, mat_wood))
        nd = max(3, int(round(d / spacing_dou)))
        for i in range(nd + 1):
            y = G.BCY - half_d + 0.35 + i * (d - 0.70) / nd
            obs.extend(bracket_set("%s_DouS%d_%d" % (name, sign, i),
                                   x_out - sign * 0.30, y, top - 0.30, col,
                                   mat_wood, mat_gold))

    return obs


# ------------------------------------------------------------------ build
def build_main_roof(col):
    """Main hip roof over the whole hall."""
    w, d = G.ROOF_W, G.ROOF_D
    eave_z = G.ROOF_MAIN_EAVE
    ridge_z = G.RIDGE_Z
    lift, k = 0.30, 0.56
    obs = []

    slab = G.roof_grid("ROOF_MainSlab", w, d, eave_z, ridge_z, col, G.P("tile_d"),
                       nx=76, ny=68, lift=lift, k=k, thickness=0.22)
    obs.append(slab)
    obs.append(banwa_bed("TILE_Banwa", w, d, eave_z, ridge_z, col, G.P("tile_d"),
                         spacing=0.30, lift=lift, k=k))
    obs.append(tile_field("TILE_Tongwa", w, d, eave_z, ridge_z, col,
                          G.P("tile"), spacing=0.30, radius=0.080,
                          lift=lift, k=k))
    obs.append(wadang_row("TILE_Wadang", w, d, eave_z, ridge_z, col,
                          G.P("tile_d"), spacing=0.30, radius=0.092,
                          lift=lift, k=k))

    # main ridge runs along X between the two hip ridge ends
    rx = (w - d) * 0.5
    obs.append(swept_ridge("ROOF_MainRidge",
                           [(-rx, G.BCY, ridge_z + 0.02),
                            (0.0, G.BCY, ridge_z + 0.10),
                            (rx, G.BCY, ridge_z + 0.02)],
                           col, G.P("tile"), width=0.34, height=0.24, layers=3))
    obs.append(chiwen("ROOF_ChiwenL", (-rx - 0.14, G.BCY, ridge_z + 0.16), col,
                      G.P("tile"), facing=1.0, scale=1.0))
    obs.append(chiwen("ROOF_ChiwenR", (rx + 0.14, G.BCY, ridge_z + 0.16), col,
                      G.P("tile"), facing=-1.0, scale=1.0))

    # four hip ridges from the ridge ends down to the lifted corners
    for sx in (-1, 1):
        for sy in (-1, 1):
            pts = []
            x0, y0 = sx * rx, 0.0
            x1, y1 = sx * w * 0.5, sy * d * 0.5
            for s in range(9):
                t = s / 8.0
                x = x0 + (x1 - x0) * t
                y = y0 + (y1 - y0) * t
                z = G.roof_point(x, y, w, d, eave_z, ridge_z, lift=lift, k=k)
                pts.append((x, y + G.BCY, z + 0.03))
            obs.append(swept_ridge("ROOF_Hip_%d%d" % (sx, sy), pts, col,
                                   G.P("tile_d"), width=0.26, height=0.17,
                                   layers=3, taper=0.18))

    for ob in eave_assembly("ROOF_Eave", w, d, eave_z, col, G.P("wood_m"),
                            G.P("gold"), G.P("tile_d"), lift=lift, k=k,
                            ridge_z=ridge_z):
        obs.append(ob)


    joined = G.join_objs("ROOF_MAIN", obs)
    # keep the tile objects separate so the web can hide tiles alone if needed
    return joined


def build_skirt_roof(col):
    """Skirt (pent) roof around the second floor, over the veranda."""
    w, d = G.BW + G.SKIRT_OV * 2.0, G.BD + G.SKIRT_OV * 2.0
    eave_z = G.EAVE_Z
    ridge_z = G.SKIRT_IN
    lift, k = 0.18, 0.62
    obs = []
    obs.append(G.roof_grid("ROOF_SkirtSlab", w, d, eave_z, ridge_z, col,
                           G.P("tile_d"), nx=64, ny=56, lift=lift, k=k,
                           ring_inner=(G.BW - 0.02, G.BD - 0.02),
                           thickness=0.18))
    obs.append(tile_field("TILE_SkirtTongwa", w, d, eave_z, ridge_z, col,
                          G.P("tile"), spacing=0.28, radius=0.070,
                          lift=lift, k=k))
    obs.append(wadang_row("TILE_SkirtWadang", w, d, eave_z, ridge_z, col,
                          G.P("tile_d"), spacing=0.28, radius=0.080,
                          lift=lift, k=k))
    for ob in eave_assembly("ROOF_SkirtEave", w, d, eave_z, col, G.P("wood_m"),
                            G.P("gold"), G.P("tile_d"), spacing_raf=0.26,
                            spacing_dou=0.58, lift=lift, k=k, simple=True,
                            ridge_z=ridge_z):
        obs.append(ob)
    return G.join_objs("ROOF_SKIRT", obs)


# ================================================================ xieshan
# Hip-and-gable (歇山). The V5 roof was a pure hip (庑殿): a single pyramidal
# surface with a 3 m ridge. The concept art shows a hip-and-gable: the upper
# storey roof is a two-slope gable, the lower part is a four-sided hip skirt
# (撒头), and the ends carry a vertical gable face (山花) with bargeboards
# (博风板). This section rebuilds the main roof on that topology.
#
#   z(x, y) = gable profile gz(|y|)                          for |x| <= half_w - g
#           = min(gz(|y|), skirt profile sz(|x|))            otherwise
#
# g is 收山, the set-in of the gable plane from the roof edge.
GABLE_G = 1.28
GABLE_Z = 8.42


def _xz(x, y, w, d, eave_z, ridge_z, g=GABLE_G, z_s=GABLE_Z, lift=0.62, k=0.44):
    """Hip-and-gable surface.

    The upper part is the gable profile (a function of |y| only). Outside the
    gable span the surface is the ORIGINAL hip surface, so the skirt keeps
    sloping down to the eave in both directions instead of forming a flat
    horizontal band (the first attempt's defect).

    The vertical gable face (shanhua) is the wedge between the gable profile and
    the hip surface at x = +-(half_w - g); it closes the strip min() opens.
    """
    half_w, half_d = w * 0.5, d * 0.5
    ty = min(1.0, abs(y) / half_d)
    gz = G.apex_z(1.0 - ty, eave_z, ridge_z, k)
    if abs(x) <= half_w - g:
        z = gz
    else:
        dist = min(half_d - abs(y), half_w - abs(x))
        t = max(0.0, min(1.0, dist / half_d))
        zh = G.apex_z(t, eave_z, ridge_z, k)
        z = min(gz, zh)
    fade = max(0.0, 1.0 - (z - eave_z) / 1.55)
    if fade > 0.0:
        acc = 0.0
        for cx in (-half_w, half_w):
            for cy in (-half_d, half_d):
                dd = math.hypot(x - cx, y - cy)
                acc = max(acc, math.exp(-(dd / 2.05) ** 2))
        z += lift * acc * (fade ** 2)
    return z


def _normal_at(zf, x, y, eps=0.06):
    p0 = Vector((x, y, zf(x, y)))
    px = Vector((x + eps, y, zf(x + eps, y)))
    py = Vector((x, y + eps, zf(x, y + eps)))
    n = (px - p0).cross(py - p0)
    if n.length < 1e-7:
        return Vector((0.0, 0.0, 1.0))
    n.normalize()
    if n.z < 0:
        n = -n
    return n


def roof_shell_x(name, w, d, eave_z, ridge_z, col, material, nx=80, ny=72,
                 thickness=0.17):
    zf = lambda x, y: _xz(x, y, w, d, eave_z, ridge_z)
    top, bot = [], []
    for j in range(ny + 1):
        y = -d * 0.5 + d * j / ny
        r0, r1 = [], []
        for i in range(nx + 1):
            x = -w * 0.5 + w * i / nx
            z = zf(x, y)
            r0.append((x, y + G.BCY, z))
            r1.append((x, y + G.BCY, z - thickness))
        top.append(r0)
        bot.append(r1)
    verts = [v for r in top for v in r] + [v for r in bot for v in r]
    n = (nx + 1) * (ny + 1)
    faces = []
    for j in range(ny):
        for i in range(nx):
            a = j * (nx + 1) + i
            q = (a, a + 1, a + nx + 2, a + nx + 1)
            faces.append(q)
            faces.append(tuple(reversed(tuple(v + n for v in q))))
    for j in range(ny):
        for i in (0, nx):
            a = j * (nx + 1) + i
            b = (j + 1) * (nx + 1) + i
            faces.append((a, b, b + n, a + n) if i == 0 else (b, a, a + n, b + n))
    for i in range(nx):
        for j in (0, ny):
            a = j * (nx + 1) + i
            b = j * (nx + 1) + i + 1
            faces.append((b, a, a + n, b + n) if j == 0 else (a, b, b + n, a + n))
    ob = G.add_mesh(name, verts, faces, col, material)
    G.shade_smooth(ob)
    return ob


def _rib_at(verts, faces, pts, radius, zf, arc=6, base_off=0.012):
    rings = []
    for idx, p in enumerate(pts):
        nrm = _normal_at(zf, p[0], p[1])
        p_prev = pts[max(0, idx - 1)]
        p_next = pts[min(len(pts) - 1, idx + 1)]
        tan = Vector((p_next[0] - p_prev[0], p_next[1] - p_prev[1],
                      p_next[2] - p_prev[2]))
        if tan.length < 1e-6:
            tan = Vector((0.0, 1.0, 0.0))
        tan.normalize()
        side = tan.cross(nrm)
        if side.length < 1e-6:
            continue
        side.normalize()
        centre = Vector(p) + nrm * base_off
        ring = []
        for a in range(arc + 1):
            ang = math.pi * a / arc
            ring.append(centre + side * (radius * math.cos(ang)) +
                        nrm * (radius * math.sin(ang)))
        rings.append(ring)
    if len(rings) < 2:
        return
    start = len(verts)
    for ring in rings:
        verts.extend([tuple(v) for v in ring])
    span = arc + 1
    for idx in range(len(rings) - 1):
        for a in range(arc):
            v0 = start + idx * span + a
            faces.append((v0, v0 + 1, v0 + span + 1, v0 + span))
    faces.append(tuple(start + a for a in range(arc + 1)))
    last = start + (len(rings) - 1) * span
    faces.append(tuple(last + a for a in range(arc, -1, -1)))


def tile_field_x(name, w, d, eave_z, ridge_z, col, material, spacing=0.30,
                 radius=0.086, g=GABLE_G, z_s=GABLE_Z):
    verts, faces = [], []
    zf = lambda x, y: _xz(x, y, w, d, eave_z, ridge_z, g, z_s)
    half_w, half_d = w * 0.5, d * 0.5
    step = 0.13

    # front / back slopes: only inside the gable span, eave to ridge
    n_x = int(round((2 * (half_w - g)) / spacing))
    for i in range(n_x + 1):
        x = -(half_w - g) + (2 * (half_w - g)) * i / n_x
        for sign in (-1, 1):
            pts = []
            y = sign * half_d
            y_lim = 0.0
            while (sign > 0 and y >= y_lim) or (sign < 0 and y <= y_lim):
                z = zf(x, y)
                pts.append((x, y + G.BCY, z))
                y -= sign * step
            if len(pts) >= 3:
                _rib_at(verts, faces, pts, radius, zf)

    # side skirts: from the side eave inward until the gable plane
    n_y = int(round(d / spacing))
    for j in range(n_y + 1):
        y = -half_d + d * j / n_y
        for sign in (-1, 1):
            pts = []
            x = sign * half_w
            while abs(x) >= half_w - g - 1e-6:
                z = zf(x, y)
                pts.append((x, y + G.BCY, z))
                x -= sign * step
            if len(pts) >= 3:
                _rib_at(verts, faces, pts, radius, zf)
    return G.add_mesh(name, verts, faces, col, material)


def build_gable_end(col, sx, w, d, eave_z, ridge_z, g=GABLE_G, z_s=GABLE_Z):
    """Vertical gable face (山花) + bargeboards (博风板) + hanging fish (悬鱼).

    A bare plaster triangle was the weakest read on the whole roof: at this
    scale the gable ends are the second-largest surface after the tile fields,
    so they carry a dark timber infill panel, a gold edge and the small
    teardrop ornament that brackets the ridge end.
    """
    half_w, half_d = w * 0.5, d * 0.5
    x = sx * (half_w - g)
    zf = lambda xx, yy: _xz(xx, yy, w, d, eave_z, ridge_z, g, z_s)
    ty_s = 1.0 - 0.53
    y_s = ty_s * half_d
    n = 16
    prof = []
    for k in range(n + 1):
        y = -y_s + 2 * y_s * k / n
        prof.append((x, y + G.BCY, zf(x, y)))
    obs = []
    # 1) the structural face: triangle fan from the bottom-left corner
    verts = [(x, -y_s + G.BCY, z_s)] + prof + [(x, y_s + G.BCY, z_s)]
    faces = []
    for k in range(len(verts) - 2):
        faces.append((0, 1 + k, 2 + k))
    obs.append(G.add_mesh("ROOF_Gable%d" % sx, verts, faces, col, G.P("plaster_d")))

    # 2) timber infill panel, inset from the edges and proud of the face
    apex = (x, G.BCY, ridge_z - 0.10)
    bl = (x, -y_s + 0.30 + G.BCY, z_s + 0.12)
    br = (x, y_s - 0.30 + G.BCY, z_s + 0.12)
    cx = (bl[0] + br[0] + apex[0]) / 3.0
    cy = (bl[1] + br[1] + apex[1]) / 3.0
    cz = (bl[2] + br[2] + apex[2]) / 3.0
    k_in = 0.80
    off = sx * 0.05
    tri = []
    for p in (bl, br, apex):
        tri.append((cx + (p[0] - cx) * k_in + off,
                    cy + (p[1] - cy) * k_in,
                    cz + (p[2] - cz) * k_in))
    obs.append(G.add_mesh("ROOF_GablePanel%d" % sx, tri, [(0, 1, 2)], col,
                          G.P("wood")))

    # 3) gold edge along both slopes + at the base
    for sign in (-1, 1):
        line = []
        for k in range(n + 1):
            y = sign * (y_s - 2 * y_s * k / n)
            line.append((x + sx * 0.09, y + G.BCY, zf(x, y) + 0.01))
        obs.append(_bargeboard("ROOF_GableTrim%d%d" % (sx, sign), line, col,
                               drop=0.07, thick=0.05))
    # 4) bargeboards: hanging ribbons along both slopes
    for sign in (-1, 1):
        line = []
        for k in range(n + 1):
            y = sign * (y_s - 2 * y_s * k / n)
            line.append((x + sx * 0.05, y + G.BCY, zf(x, y) + 0.02))
        obs.append(_bargeboard("ROOF_Barge%d%d" % (sx, sign), line, col))

    # 5) 悬鱼: the teardrop ornament at the ridge end
    obs.append(G.add_cone("ROOF_Xuanyu%d" % sx, 0.14, 0.015, 0.52,
                          (x + sx * 0.10, G.BCY, ridge_z - 0.42), col,
                          G.P("gold"), segments=10, rot=(math.pi, 0, 0)))
    obs.append(G.add_cyl("ROOF_XuanyuCap%d" % sx, 0.11, 0.06,
                         (x + sx * 0.10, G.BCY, ridge_z - 0.14), col,
                         G.P("gold"), segments=10))
    return obs


def _bargeboard(name, line, col, drop=0.17, thick=0.09):
    verts, faces = [], []
    for p in line:
        verts.append((p[0], p[1], p[2]))
        verts.append((p[0], p[1], p[2] - drop))
    for k in range(len(line) - 1):
        a = k * 2
        faces.append((a, a + 1, a + 3, a + 2))
    return G.add_mesh(name, verts, faces, col, G.P("wood_l"))


def build_main_roof_xieshan(col):
    w, d = G.ROOF_W, G.ROOF_D
    eave_z, ridge_z = G.ROOF_MAIN_EAVE, G.RIDGE_Z
    half_w, half_d = w * 0.5, d * 0.5
    obs = []
    obs.append(roof_shell_x("ROOF_MainSlab", w, d, eave_z, ridge_z, col,
                            G.P("tile_d")))
    obs.append(tile_field_x("TILE_Tongwa", w, d, eave_z, ridge_z, col,
                            G.P("tile")))
    obs.append(wadang_row("TILE_Wadang", w, d, eave_z, ridge_z, col,
                          G.P("tile_d"), spacing=0.30, radius=0.096,
                          lift=0.62, k=0.44))
    rx = half_w - GABLE_G
    obs.append(swept_ridge("ROOF_MainRidge",
                           [(-rx, G.BCY, ridge_z + 0.02),
                            (0.0, G.BCY, ridge_z + 0.10),
                            (rx, G.BCY, ridge_z + 0.02)],
                           col, G.P("tile"), width=0.34, height=0.24, layers=3))
    obs.append(chiwen("ROOF_ChiwenL", (-rx - 0.12, G.BCY, ridge_z + 0.16), col,
                      G.P("tile"), facing=1.0, scale=1.0))
    obs.append(chiwen("ROOF_ChiwenR", (rx + 0.12, G.BCY, ridge_z + 0.16), col,
                      G.P("tile"), facing=-1.0, scale=1.0))
    # 戗脊: from where the gable meets the skirt down to each plan corner
    y_s = 0.53 * half_d
    for sx in (-1, 1):
        for sy in (-1, 1):
            p0 = (sx * (half_w - GABLE_G), sy * y_s + G.BCY, GABLE_Z + 0.03)
            p1 = (sx * half_w, sy * half_d + G.BCY, eave_z + 0.12)
            pts = []
            for s in range(7):
                t = s / 6.0
                pts.append((p0[0] + (p1[0] - p0[0]) * t,
                            p0[1] + (p1[1] - p0[1]) * t,
                            p0[2] + (p1[2] - p0[2]) * t))
            obs.append(swept_ridge("ROOF_Hip_%d%d" % (sx, sy), pts, col,
                                   G.P("tile_d"), width=0.24, height=0.15,
                                   layers=3, taper=0.18))
    for sx in (-1, 1):
        obs.extend(build_gable_end(col, sx, w, d, eave_z, ridge_z))
    for ob in eave_assembly("ROOF_Eave", w, d, eave_z, col, G.P("wood_m"),
                            G.P("gold"), G.P("tile_d"), lift=0.62, k=0.44):
        obs.append(ob)
    return G.join_objs("ROOF_MAIN", obs)


def build(col_roof):
    build_skirt_roof(col_roof)
    build_main_roof_xieshan(col_roof)
    return G.LOG
